# Environment for slash-sysemu.service (read via EnvironmentFile).

# Path to the daemon's INI configuration file.
SLASH_SYSEMU_CONFIG=/etc/slash_sysemu/slash_sysemu.conf

# Extra arguments appended to the daemon command line, e.g. to override the
# default startup VBIN:
#   SLASH_SYSEMU_EXTRA_ARGS=--default-vbin /path/to/default.vbin
SLASH_SYSEMU_EXTRA_ARGS=

# Prepending the path to Vivado's runtime libraries, including xsim.
# This is necessary in order to support FPGA simulation. Systems with a non-standard
# Vivado installation need to change this path.
LD_LIBRARY_PATH=/tools/Xilinx/2025.1/Vivado/lib/lnx64.o/:$LD_LIBRARY_PATH

# Alternatively, redirect just the default startup VBIN (the daemon already
# defaults to /usr/lib/slash-sysemu/default.vbin):
# SLASH_SYSEMU_DEFAULT_VBIN=/usr/lib/slash-sysemu/default.vbin

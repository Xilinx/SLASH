<SystemMap>
  <Platform>{{ platform }}</Platform>
  <ClockFrequency>{{ clock_hz }}</ClockFrequency>
  <ServiceLayer>
    <Ethernet enabled="{{ "true" if service_layer.eth_enabled else "false" }}">
{% for idx in service_layer.eth_indices %}
      <eth index="{{ idx }}" />
{% endfor %}
    </Ethernet>
    <VIRT>
{% for v in service_layer.virt %}
      <interface index="{{ v.index }}" connection="{{ v.connection }}" />
{% endfor %}
    </VIRT>
  </ServiceLayer>
</SystemMap>
